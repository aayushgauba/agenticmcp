# Copy to .env and edit locally. Never commit secrets or server state.
MUSE_LOCAL_HTTP=1
MUSE_PUBLIC_URL=http://127.0.0.1:8000
MUSE_API_MODE=forward
# Leave blank to receive requests without sending anything outbound.
MUSE_FORWARD_BASE_URL=
MUSE_FORWARD_BEARER_TOKEN=
# Optional later: a bare HTTPS origin such as https://api.example.com
# Public hosting: MUSE_LOCAL_HTTP=0 and the actual HTTPS MUSE_PUBLIC_URL.

# Disposable shared project: off until explicitly configured by the operator.
MUSE_SANDBOX_ENABLED=0
MUSE_SANDBOX_RUN_ID=
MUSE_SANDBOX_DIRECT_ENABLED=0
# Generate a distinct random credential of at least 32 characters privately.
MUSE_SANDBOX_DIRECT_TOKEN=
