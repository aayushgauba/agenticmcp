# Local development. Configure a private secret and hostname on deployment.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_COOKIES=0

# Muse approval gateway. Run init_muse once for private credentials and keys.
MUSE_API_MODE=forward
MUSE_FORWARD_BASE_URL=
MUSE_FORWARD_BEARER_TOKEN=
