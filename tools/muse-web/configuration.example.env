# Copy to .env and edit locally. Never commit .env or server state.
MUSE_LOCAL_HTTP=1
MUSE_PUBLIC_URL=http://127.0.0.1:8000
MUSE_GITHUB_REPOSITORIES=owner/repository
MUSE_GITHUB_TOKEN=
# For an HTTPS deployment, set MUSE_LOCAL_HTTP=0 and the real public HTTPS origin.
# Keep state/ (Django secret, connector token, signing key, DB) private to the server.
